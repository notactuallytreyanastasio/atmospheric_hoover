<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-gradient-to-br from-pink-100 via-purple-100 to-blue-100 dark:from-gray-900 dark:via-purple-900 dark:to-blue-900">
  <div class="flex flex-col items-center justify-center min-h-screen px-4">
    <div class="text-center max-w-2xl">
      <h1 class="text-5xl font-bold bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500 bg-clip-text text-transparent mb-4">
        Atmospheric Hoover
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Real-time Bluesky firehose visualization
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-lg mx-auto">
        <a
          href="/grid"
          class="group relative overflow-hidden rounded-2xl bg-white/80 dark:bg-gray-800/80 p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-pink-200/50 to-purple-200/50 dark:from-pink-800/30 dark:to-purple-800/30 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="text-4xl mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">
              Post Grid
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              Watch posts slide in from all directions in a colorful animated grid
            </p>
          </div>
        </a>

        <a
          href="/firehose"
          class="group relative overflow-hidden rounded-2xl bg-white/80 dark:bg-gray-800/80 p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-blue-200/50 to-cyan-200/50 dark:from-blue-800/30 dark:to-cyan-800/30 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative">
            <div class="text-4xl mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">
              Raw Firehose
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              Full firehose stream with real-time text search filtering
            </p>
          </div>
        </a>
      </div>

      <div class="mt-12 flex justify-center">
        <Layouts.theme_toggle />
      </div>

      <p class="mt-8 text-sm text-gray-500 dark:text-gray-400">
        Powered by Phoenix LiveView + Broadway
      </p>
    </div>
  </div>
</div>
